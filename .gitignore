# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Backups of an env file are still an env file.
.env*.bak
# The build scripts move .env.local aside under these names while they run. A
# `git add -A` in that window committed one; the pattern above does not match
# a name that ends in something other than .local.
.env.local.*
# SMTP credentials for `supabase config push`. Deliberately not named
# .env-anything: Expo pulls every .env* at the root into the bundler graph and
# then fails trying to parse it as JavaScript.
.smtp.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Verification screenshots. Kept on disk, not in the repo — they are
# artifacts of testing, not source.
shots/

# Browser-automation scratch from local UI checks
.playwright-mcp/

# Xcode archives and exported builds, made by scripts/upload-testflight.sh.
build/

# The SES credentials, kept while migrating to Resend.
.smtp.local.ses-backup
