# Local Supabase, started with `npx supabase start`.
# EXPO_PUBLIC_* is inlined into the bundle — only ever put the publishable key
# here, never the secret one.
#
# On a physical phone, 127.0.0.1 is the phone. Swap in this machine's LAN
# address (`ipconfig getifaddr en0`) to test on a real device.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
